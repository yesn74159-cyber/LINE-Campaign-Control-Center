{
  "name": "line-campaign-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Staging-first LINE Campaign Control Center with a responsive Admin PWA and dry-run API.",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "cross-env PERSISTENCE=memory APP_MODE=DRY_RUN tsx watch apps/api/src/server.ts",
    "dev:staging": "cross-env PERSISTENCE=postgres APP_MODE=DRY_RUN tsx watch apps/api/src/server.ts",
    "worker:staging": "cross-env PERSISTENCE=postgres APP_MODE=DRY_RUN LINE_WEBHOOK_ENABLED=false tsx apps/api/src/worker.ts",
    "worker:once": "cross-env PERSISTENCE=postgres APP_MODE=DRY_RUN LINE_WEBHOOK_ENABLED=false tsx apps/api/src/worker.ts --once",
    "dev:admin": "vite --config vite.config.mjs",
    "build": "npm run typecheck && npm run build:admin && npm run build:api",
    "build:admin": "vite build --config vite.config.mjs --configLoader runner",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:api": "node dist/api/server.js",
    "db:migrate": "tsx apps/api/src/cli.ts migrate",
    "db:seed": "tsx apps/api/src/cli.ts seed",
    "db:setup": "tsx apps/api/src/cli.ts setup",
    "test:db-connection": "tsx apps/api/src/connectionCheck.ts",
    "test:ssl-certificate": "tsx apps/api/src/sslCertificateCheck.ts",
    "test": "node --test tests/core.test.mjs tests/phase1.test.mjs",
    "test:integration": "npm run build:api && node --test tests/integration.test.mjs",
    "test:security": "npm run build:api && node --test tests/security.test.mjs",
    "test:phase3": "npm run build:api && node --test tests/phase3.integration.test.mjs",
    "test:oa": "npm run build:api && node --test tests/oa-adapter.test.mjs",
    "test:line-login": "npm run build:api && node --test tests/line-login.test.mjs",
    "test:line-login:postgres": "npm run build:api && node --test tests/line-login-postgres.integration.test.mjs",
    "test:phase4a": "npm run build:api && node --test tests/phase4a.integration.test.mjs",
    "test:phase4b": "npm run build:api && node --test --test-concurrency=1 tests/phase4b.integration.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.visual.test.mjs",
    "test:tenant": "npm run build:api && node --test tests/multitenant-login.test.mjs tests/tenant-admin-api.test.mjs tests/multitenant-foundation.integration.test.mjs",
    "test:tenant:ui": "npm run build:admin && node --test tests/tenant-admin.ui.test.mjs",
    "test:oa:connect": "npm run build:api && node --test tests/oa-live-connect.test.mjs",
    "test:live-contract": "npm run build:api && node --test tests/live-push-payload.test.mjs",
    "test:campaign-mock": "npm run build:api && node --test tests/campaign-mock.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
