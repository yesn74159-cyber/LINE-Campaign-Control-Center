# Public TLS edge for staging. Only the Admin/Nginx container is reachable from
# here: the API and worker stay on the private Compose network.
{
	email {$ACME_EMAIL:ops@example.invalid}
}

(tls_edge) {
	encode zstd gzip
	request_body {
		max_size 1MB
	}

	@notshare not path /share /share/*

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# The LIFF share page is framed by liff.line.me on purpose. This edge used to put
	# X-Frame-Options on every response, which would have re-blocked it no matter what
	# nginx answered, so DENY is scoped to everything except that path.
	header @notshare X-Frame-Options "DENY"

	reverse_proxy admin:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}

# Local rehearsal keeps an internal CA; real staging sets CADDY_TLS to an email
# so Caddy obtains a public certificate through ACME.
{$STAGING_DOMAIN:localhost} {
	tls {$CADDY_TLS:internal}
	import tls_edge
}

# Optional second name (e.g. the sslip.io alias kept after the real domain
# lands). Unset STAGING_ALT_DOMAIN to drop the block.
{$STAGING_ALT_DOMAIN:localhost} {
	tls {$CADDY_TLS:internal}
	import tls_edge
}
