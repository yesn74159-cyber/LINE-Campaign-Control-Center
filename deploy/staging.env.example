# Copy to .env.staging on the host (never commit it) and start Compose with
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build
# Values below are placeholders. Anything blank must be supplied from a secret
# store or a local .env.staging file before the stack will start.

# --- Compose / Caddy -------------------------------------------------------
POSTGRES_USER=line_ccc
POSTGRES_PASSWORD=
POSTGRES_DB=line_campaign_ccc
# Local rehearsal: STAGING_DOMAIN=localhost keeps Caddy on an internal CA.
# Real staging: set the hostname and CADDY_TLS to the ACME account email.
STAGING_DOMAIN=localhost
CADDY_TLS=internal
ACME_EMAIL=ops@example.invalid

# --- API / worker runtime --------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
APP_MODE=DRY_RUN
PERSISTENCE=postgres
# Compose service name is postgres; keep credentials in this file only.
# Encode special characters, or prefer a secret store that injects this value.
DATABASE_URL=postgres://line_ccc:REPLACE_ME@postgres:5432/line_campaign_ccc
DB_SCHEMA=public
DB_EXTENSION_SCHEMA=public
DB_SSL_MODE=disable
DB_POOL_MODE=session
DB_POOL_MAX=5
# Exactly one browser origin, comma separated when several are needed.
PUBLIC_APP_ORIGIN=https://staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
# Rate limiting and audit trails need the real client address behind Caddy/Nginx.
TRUST_PROXY=true
WORKER_POLL_MS=1000

# --- Alert thresholds (read by /api/ops/delivery-health and `npm run ops:health`)
OPS_STUCK_MINUTES=15
OPS_WORKER_STALE_MINUTES=10
OPS_QUOTA_WARN_PERCENT=80
# Optional HTTPS webhook for cron-driven `ops:health -- --notify`; blank disables it.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_FORMAT=generic

# --- Seeder only (run once, then remove the password values) ---------------
STAGING_ADMIN_EMAIL=admin@staging.local
STAGING_ADMIN_PASSWORD=
STAGING_VIEWER_EMAIL=viewer@staging.local
STAGING_VIEWER_PASSWORD=

# --- LINE safety switches: all off until a separate approval --------------
LINE_LIVE_ENABLED=false
LINE_WEBHOOK_ENABLED=false
# Base64 32-byte AES-256-GCM key for the OA vault. Inject from a secret store.
LINE_CREDENTIAL_ENCRYPTION_KEY=
STAGING_WEBHOOK_SECRET=
LINE_CHANNEL_SECRET=

LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=https://staging.example.invalid/api/line-login/callback
LINE_IDENTITY_HASH_KEY=
LINE_LOGIN_FLOW_ENCRYPTION_KEY=
LINE_LOGIN_COOKIE_SECURE=true

# LIFF app registered on the LINE Login channel. The id appears in every share link, so it is
# not a secret; the Admin bundle reads it from /api/config instead of being rebuilt per channel.
LINE_LIFF_CHANNEL_ID=
# Add-friend link the shipped Flex templates point their button at.
LINE_OA_FRIEND_URL=
