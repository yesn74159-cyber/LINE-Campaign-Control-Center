# Staging defaults. Never commit Channel Secret or Access Token values.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
APP_MODE=DRY_RUN
PERSISTENCE=postgres
# Select the server-side connection profile. Keep actual URLs outside this file.
DB_TARGET=LOCAL_DEV
LOCAL_DATABASE_URL=
CLOUD_STAGING_DATABASE_URL=
DATABASE_URL=
DB_SCHEMA=public
DB_EXTENSION_SCHEMA=public
DB_SSL_MODE=disable
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_FILE=
DB_POOL_MODE=session
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
# Optional public origin used for generated links. No credentials belong here.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Set true only behind the staging Nginx/Caddy edge so rate limits see the real client IP.
TRUST_PROXY=false
# Alert thresholds used by /api/ops/delivery-health and `npm run ops:health`.
OPS_STUCK_MINUTES=15
OPS_WORKER_STALE_MINUTES=10
OPS_QUOTA_WARN_PERCENT=80
# Optional HTTPS webhook used by `npm run ops:health -- --notify`; blank disables delivery.
OPS_ALERT_WEBHOOK_URL=
# generic (structured JSON), slack ({text}), or discord ({content}).
OPS_ALERT_FORMAT=generic
# Public Admin build setting only; leave blank when Admin and API share one origin.
VITE_API_ORIGIN=
# Staging admin seed only. Set a strong value outside this file.
STAGING_ADMIN_EMAIL=admin@staging.local
STAGING_ADMIN_PASSWORD=
STAGING_VIEWER_EMAIL=viewer@staging.local
STAGING_VIEWER_PASSWORD=
# Staging integration test only: the OA vault Channel Secret used to sign test webhooks.
STAGING_WEBHOOK_SECRET=
# Memory/mock mode only. Never reuse a production or cloud credential here.
MEMORY_ADMIN_EMAIL=admin@memory.local
MEMORY_ADMIN_PASSWORD=
# Webhook remains closed until explicitly enabled for a staging OA.
LINE_WEBHOOK_ENABLED=false
# Live sending stays locked. Enabling requires APP_MODE=LIVE, this flag, and the vault key.
LINE_LIVE_ENABLED=false
# Memory/mock mode only. PostgreSQL webhooks verify with the OA's vault secret.
LINE_CHANNEL_SECRET=
# Base64 32-byte AES-256-GCM key for the OA credential vault. Supply from a secret store.
LINE_CREDENTIAL_ENCRYPTION_KEY=
# Rotation only: OLD falls back to the current key; set NEW, run `npm run vault:rotate`,
# then promote NEW to LINE_CREDENTIAL_ENCRYPTION_KEY and clear both.
LINE_CREDENTIAL_ENCRYPTION_KEY_OLD=
LINE_CREDENTIAL_ENCRYPTION_KEY_NEW=
# LINE Login v2.1 member OIDC; keep disabled until local values are supplied.
LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://127.0.0.1:8787/api/line-login/callback
LINE_IDENTITY_HASH_KEY=
LINE_LOGIN_FLOW_ENCRYPTION_KEY=
LINE_LOGIN_COOKIE_SECURE=false
