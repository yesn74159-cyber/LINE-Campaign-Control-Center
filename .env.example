# Staging defaults. Never commit Channel Secret or Access Token values.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
APP_MODE=DRY_RUN
PERSISTENCE=postgres
# Select the server-side connection profile. Keep actual URLs outside this file.
DB_TARGET=LOCAL_DEV
LOCAL_DATABASE_URL=
CLOUD_STAGING_DATABASE_URL=
DATABASE_URL=
DB_SCHEMA=public
DB_EXTENSION_SCHEMA=public
DB_SSL_MODE=disable
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_FILE=
DB_POOL_MODE=session
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
# Optional public origin used for generated links. No credentials belong here.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Public Admin build setting only; leave blank when Admin and API share one origin.
VITE_API_ORIGIN=
# Staging admin seed only. Set a strong value outside this file.
STAGING_ADMIN_EMAIL=admin@staging.local
STAGING_ADMIN_PASSWORD=
STAGING_VIEWER_EMAIL=viewer@staging.local
STAGING_VIEWER_PASSWORD=
# Memory/mock mode only. Never reuse a production or cloud credential here.
MEMORY_ADMIN_EMAIL=admin@memory.local
MEMORY_ADMIN_PASSWORD=
# Webhook remains closed until explicitly enabled for a staging OA.
LINE_WEBHOOK_ENABLED=false
LINE_CHANNEL_SECRET=
